# Local development values only. Never use these credentials in staging or
# production, and never commit a real backend/.env file.
APP_NAME="Community API"
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://community_dev:local_dev_only@localhost:5433/community_dev
POSTGRES_DB=community_dev
POSTGRES_USER=community_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=5433
