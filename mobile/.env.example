# Copy this file to .env.development.local and edit it for your current setup.
# Expo reads these values at development/build time; EXPO_PUBLIC_* values ship
# inside the app and are visible to its users. Never put secrets here.

# Local FastAPI URL, including the API prefix. See URLS.md for Android emulator
# and physical-device addresses; this is public configuration, never a secret.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Used for diagnostics and environment-aware behavior; never for secrets.
EXPO_PUBLIC_APP_ENV=development

# Optional canonical website URL for links opened outside the app.
# Leave empty until a website/domain exists. This is not the Expo dev-server URL.
EXPO_PUBLIC_WEB_BASE_URL=

# The Expo Metro / development-server tunnel URL is generated by the Expo CLI
# when starting the development server. Do not copy it into this file.
